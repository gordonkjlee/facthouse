{
  "name": "@openmem/mcp",
  "version": "0.22.0",
  "description": "Local-first AI memory engine exposed as an MCP server. You own the SQLite file.",
  "type": "module",
  "license": "MIT",
  "author": "Gordon Lee",
  "repository": {
    "type": "git",
    "url": "https://github.com/gordonkjlee/openmemory"
  },
  "bin": {
