{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    // Declare the Node types explicitly. They were previously only in scope via
    // a `/// <reference types="node" />` inside @types/better-sqlite3 — so
    // dropping that dependency silently removed `process`, `Buffer`, and the
    // NodeJS namespace from every file. Depend on them directly.
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
